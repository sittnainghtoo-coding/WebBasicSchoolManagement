<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link rel="stylesheet" href="https://cloudflare.com" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container-fluid">
          <!--Title-->
            <a class="navbar-brand fw-bolder px-5" href="@Url.Action("Index", "Home")" style="font-size:25px !important; cursor: none">School Management System</a>
        </div>
    </nav>
    <div class="wrapper">

        <!--Side Bar-->
        <div class="sidebar">
            <div style="display:flex;align-content:center;justify-content:center">
                <img src="~/Images_container/logo.jpg" alt="logo" style="width:150px;height150px;border-radius:50%"/>
            </div>
            <ul style="list-style:none;padding:0 !important;margin-top:10px">
                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link fa fa-regular fa-user " })
                </li>
                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                </li>

                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                </li>
                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                </li>
                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                </li>
            </ul>
        </div>


        <!--Main Content Area-->
        <div class="wrapper-content">
            @RenderBody()

        </div>
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
