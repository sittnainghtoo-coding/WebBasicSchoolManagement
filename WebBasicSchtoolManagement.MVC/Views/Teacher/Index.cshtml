@using WebBasicSchoolManagement.Database.AppDbContextModels
@model List<TeacherViewModel.TeacherVM>
@{
	ViewData["Title"] = "Teacher Page";
}
<main class="container-fluid">
	<section class="row">
		<h3>Teacher List</h3>
	</section>
	@if (Model.Count == 0)
	{
		<div class="alert alert-danger" role="alert">
			No Teacher Found
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
		</div>
	}

	<section>
		<a href="Teacher/Add
" class="btn btn-outline-primary"><i class="fa fa-user-plus"></i> Add new Teacher</a>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>No.</th>
					<th>Name</th>
					<th>Student</th>
					<th></th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@{int i = 0;}
				@foreach (TeacherViewModel.TeacherVM item in Model)
				{
					i++;
					<tr>
						<td>@i</td>
						<td>@item.Name</td>
						<td>@item.Subject</td>						
						<td>
							<a href="/teacher/Edit/@(item.Id)" class="btn btn-warning">Edit</a>
						</td>
						<td>
							<a href="/teacher/delete/@(item.Id)" class="btn btn-danger">Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
</main>

