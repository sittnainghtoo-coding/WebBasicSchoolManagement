<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebBasicSchtoolManagement.MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBasicSchtoolManagement.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

   
</head>
<body>

    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container-fluid">
            <!--Title-->
            <a class="navbar-brand fw-bolder px-5" href="@Url.Action("Index", "Home")" style="font-size:25px !important; cursor: none">School Management System</a>
        </div>
    </nav>
    
        <div class="wrapper">

            <!--Side Bar-->
            <div class="sidebar">
                <div style="display:flex;align-content:center;justify-content:center">
                     <img src="~/img/logo.jpg" alt="logo" style="width:150px;height150px;border-radius:50%" />
                </div>
                <ul style="list-style:none;padding:0 !important;margin-top:10px">

                <li class="nav-item">
                    @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link fa fa-users" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink(" Teacher Management", "Index", "Teacher", new { area = "" }, new { @class = "nav-link fa fa-grid" })

                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                    </li>
                    <li class="nav-item">
                        @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                    </li>
                    <li class="nav-item">
                        @Html.ActionLink(" Student Management", "Index", "Student", new { area = "" }, new { @class = "nav-link" })

                    </li>
                </ul>
            </div>
        <!--Main Content Area-->
        <div class="wrapper-content container-fluid">
            @RenderBody()

        </div>
        
        
        </div>
   
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
