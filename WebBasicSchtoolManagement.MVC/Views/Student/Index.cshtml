@using WebBasicSchoolManagement.Database.AppDbContextModels
@model List<TblStudent>
@{
	ViewData["Title"] = "Student Page";
	string gender = string.Empty;
}
<main class="container-fluid">
	<section class="row">
	<h3>Students List</h3>
	</section>
	@if(Model.Count == 0)
	{
		<div class="alert alert-danger" role="alert">
			No Student Found
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
		</div>
	}

	<section>
		<a href="Student/Add
" class="btn btn-outline-primary"><i class="fa fa-user-plus"></i> Add new Student</a>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Student Name</th>
					<th>Student Father Name</th>
					<th>Student Age</th>
					<th>Birthday</th>
					<th>Gender</th>
					<th>Resgistration Date</th>
					<th></th>
					<th></th>

				</tr>
			</thead>
			<tbody>
				@foreach (TblStudent item in Model)
				{
					<tr>

						<td>@item.StdName</td>
						<td>@item.FatherName</td>
						<td>@item.StdAge</td>
						<td>@item.Dob</td>
						<td>@(item.Gender)</td>
						<td>@item.ResgisterDate</td>
						<td>
							<a href="/student/Edit/@(item.StdId)" class="btn btn-warning">Edit</a>
						</td>
						<td>
							<a href="/student/delete/@(item.StdId)" class="btn btn-danger">Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
</main>


